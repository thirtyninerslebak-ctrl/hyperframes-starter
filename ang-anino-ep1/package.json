{
  "name": "ang-anino-ep1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 tools/build.py",
    "dev": "npx --yes hyperframes@0.8.181 preview",
    "check": "npx --yes hyperframes@0.8.181 check",
    "render": "npx --yes hyperframes@0.8.181 render --fps 24 -q delivery -o renders/video-only.mp4",
    "audio": "python3 tools/make_audio.py audio/soundtrack.wav",
    "final": "ffmpeg -y -i renders/video-only.mp4 -i audio/final_mix.wav -map 0:v -map 1:a -c:v libx264 -preset medium -b:v 6500k -maxrate 9000k -bufsize 18000k -pix_fmt yuv420p -c:a aac -b:a 192k -shortest -movflags +faststart renders/ang-anino-sa-kagubatan-ep1.mp4",
    "voices": "python3 tools/make_voices.py audio/voices.wav",
    "mix": "ffmpeg -y -i audio/soundtrack.wav -i audio/voices.wav -filter_complex \"[0]volume=0.55[bed];[bed][1]amix=inputs=2:normalize=0,loudnorm=I=-16:TP=-1.5:LRA=11\" -ar 48000 audio/final_mix.wav"
  }
}
